{"step_index":51,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-09-14T11:31:21Z","thinking":"The backend functionality demands a comprehensive test suite. The suite will specifically address RSVP management with item quantity customization, demand aggregation for the head chef, canteen entry checks for varied registration statuses, black star penalties and automated fine triggers, fine payment with star reset, and waste logging.\n\n\n","tool_calls":[{"name":"write_to_file","args":{"CodeContent":"\"\"\"\nBackend Automated Test Suite for FeedForward\nVerifies all functional flows:\n1. Student RSVP with Veg/Non-Veg & item quantities (Idlis, Chapattis)\n2. Chef demand aggregation calculation\n3. Canteen gatekeeper check-in & no-show detection\n4. Black Star penalties & 3-star fine calculation\n5. Fine clearance\n6. Waste segregation: Animal Feed (plate scrap) vs Biogas (spoiled food)\n7. Official notification delivery\n\"\"\"\n\nimport sys\nimport os\nsys.path.insert(0, os.path.join(os.path.dirname(__file__), \"..\", \"backend\"))\n\nfrom fastapi.testclient import TestClient\nfrom app import app\nfrom database import get_connection\n\nclient = TestClient(app)\n\ndef test_get_meals():\n    response = client.get(\"/api/meals\")\n    assert response.status_code == 200\n    meals = response.json()\n    assert len(meals) >= 2\n    assert any(m[\"id\"] == \"meal_hostel_lunch\" for m in meals)\n    print(\"✓ test_get_meals PASSED\")\n\ndef test_student_rsvp_and_chef_demand():\n    # Student Rahul RSVPs for Lunch with 4 Idlis and 3 Chapattis, Non-Veg\n    payload = {\n        \"meal_id\": \"meal_hostel_lunch\",\n        \"user_id\": \"u_student_1\",\n        \"attending\": True,\n        \"dietary_choice\": \"Non-Veg\",\n        \"quantities\": {\n            \"Idlis\": 4,\n            \"Chapattis\": 3,\n            \"Steamed Rice\": 1,\n            \"Chicken Curry\": 1\n        }\n    }\n    res = client.post(\"/api/reservations\", json=payload)\n    assert res.status_code == 200\n    assert \"reservation_id\" in res.json()\n\n    # Now verify the Chef Demand Aggregator computes this accurately\n    chef_res = client.get(\"/api/chef/demand/meal_hostel_lunch\")\n    assert chef_res.status_code == 200\n    demand = chef_res.json()\n    \n    assert demand[\"attending_count\"] >= 1\n    assert demand[\"non_veg_count\"] >= 1\n    # Check that item aggregates has Idlis >= 4 and Chapattis >= 3\n    assert demand[\"item_aggregates\"][\"Idlis\"][\"count\"] >= 4\n    assert demand[\"item_aggregates\"][\"Chapattis\"][\"count\"] >= 3\n    print(f\"✓ test_student_rsvp_and_chef_demand PASSED: Chef prep sheet shows {demand['item_aggregates']['Idlis']['count']} Idlis, {demand['item_aggregates']['Chapattis']['count']} Chapattis\")\n\ndef test_canteen_entry_verification():\n    # Rahul has RSVP'd -> Gatekeeper checks in\n    entry_payload = {\n        \"meal_id\": \"meal_hostel_lunch\",\n        \"user_id\": \"u_student_1\"\n    }\n    entry_res = client.post(\"/api/canteen/entry\", json=entry_payload)\n    assert entry_res.status_code == 200\n    data = entry_res.json()\n    assert data[\"success\"] is True\n    assert data[\"status\"] == \"APPROVED\"\n    assert data[\"dietary_choice\"] == \"Non-Veg\"\n    assert data[\"quantities\"][\"Idlis\"] == 4\n    print(\"✓ test_canteen_entry_verification PASSED\")\n\ndef test_black_star_and_fine_trigger():\n    # Test Black Star logic on student Vignesh (u_student_3, currently has 1 star)\n    # Issue star #2\n    pen_1 = {\n        \"user_id\": \"u_student_3\",\n        \"meal_id\": \"meal_hostel_lunch\",\n        \"reason\": \"Excessive plate food wastage reported at dish drop\",\n        \"additional_stars\": 1\n    }\n    r1 = client.post(\"/api/canteen/penalize\", json=pen_1)\n    assert r1.status_code == 200\n    assert r1.json()[\"black_stars\"] == 2\n    assert r1.json()[\"fine_triggered\"] is False\n\n    # Issue star #3 -> MUST trigger fine!\n    pen_2 = {\n        \"user_id\": \"u_student_3\",\n        \"meal_id\": \"meal_hostel_lunch\",\n        \"reason\": \"No-show after RSVP commitment (Meal prepared and wasted)\",\n        \"additional_stars\": 1\n    }\n    r2 = client.post(\"/api/canteen/penalize\", json=pen_2)\n    assert r2.status_code == 200\n    d2 = r2.json()\n    assert d2[\"black_stars\"] == 3\n    assert d2[\"fine_triggered\"] is True\n    assert d2[\"fine_amount\"] == 100.0\n    print(f\"✓ test_black_star_and_fine_trigger PASSED: Reached 3 stars -> Fine levied ₹{d2['fine_amount']}\")\n\n    # Check notification sent to student\n    notifs = client.get(\"/api/notifications?user_id=u_student_3\").json()\n    fine_notifs = [n for n in notifs if n[\"category\"] == \"fine_alert\"]\n    assert len(fine_notifs) >= 1\n    print(\"✓ test_fine_notification PASSED\")\n\ndef test_fine_payment_and_star_reset():\n    pay_payload = {\n        \"user_id\": \"u_student_3\",\n        \"amount\": 100.0\n    }\n    pay_res = client.post(\"/api/students/pay-fine\", json=pay_payload)\n    assert pay_res.status_code == 200\n    \n    # Check student profile\n    profile = client.get(\"/api/users/u_student_3\").json()\n    assert profile[\"black_stars\"] == 0\n    assert profile[\"fines_accumulated\"] == 0.0\n    print(\"✓ test_fine_payment_and_star_reset PASSED: Black stars reset to 0 after clearance\")\n\ndef test_waste_segregation_and_official_alerts():\n    # 1. Log Clean Plate Waste -> Animal Feed\n    animal_waste = {\n        \"source_partition\": \"hostel\",\n        \"source_name\": \"Hostel Block A Mess Counter\",\n        \"waste_type\": \"animal_feed\",\n        \"weight_kg\": 14.5,\n        \"notes\": \"Untouched leftover cooked rice and idlis\",\n        \"logged_by\": \"Officer David\"\n    }\n    res_a = client.post(\"/api/waste/log\", json=animal_waste)\n    assert res_a.status_code == 200\n    waste_id_a = res_a.json()[\"waste_id\"]\n\n    # 2. Log Spoilt Food -> Biogas Plant\n    biogas_waste = {\n        \"source_partition\": \"restaurant\",\n        \"source_name\": \"Central Campus Cafeteria\",\n        \"waste_type\": \"biogas\",\n        \"weight_kg\": 28.0,\n        \"notes\": \"Spoiled curd, grease trap slurry, and rotten vegetable peelings\",\n        \"logged_by\": \"Chef Ramesh\"\n    }\n    res_b = client.post(\"/api/waste/log\", json=biogas_waste)\n    assert res_b.status_code == 200\n    waste_id_b = res_b.json()[\"waste_id\"]\n\n    # Check that Biogas official received alert\n    biogas_notifs = client.get(\"/api/notifications?role=biogas_official\").json()\n    assert any(\"28.0 kg Spoilt Food for Biogas\" in n[\"title\"] or \"28\" in n[\"message\"] for n in biogas_notifs)\n    print(\"✓ test_biogas_official_notification PASSED: Urgent alert received by Biogas official\")\n\n    # Update Biogas waste status to 'collected'\n    stat_update = {\n        \"waste_id\": waste_id_b,\n        \"status\": \"collected\",\n        \"official_id\": \"u_biogas_1\"\n    }\n    up_res = client.post(\"/api/waste/update-status\", json=stat_update)\n    assert up_res.status_code == 200\n\n    # Verify sustainability analytics\n    analytics = client.get(\"/api/waste/analytics\").json()\n    assert analytics[\"biogas_kg\"] >= 28.0\n    assert analytics[\"animal_feed_kg\"] >= 14.5\n    assert analytics[\"biogas_m3\"] > 0\n    assert analytics[\"green_kwh\"] > 0\n    print(f\"✓ test_waste_analytics PASSED: Biogas diverted: {analytics['biogas_kg']} kg ({analytics['green_kwh']} kWh green energy), Animal Feed: {analytics['animal_feed_kg']} kg ({analytics['animal_meals']} animal meals)\")\n\nif __name__ == \"__main__\":\n    print(\"\\n--- Running FeedForward Backend Verification Tests ---\")\n    test_get_meals()\n    test_student_rsvp_and_chef_demand()\n    test_canteen_entry_verification()\n    test_black_star_and_fine_trigger()\n    test_fine_payment_and_star_reset()\n    test_waste_segregation_and_official_alerts()\n    print(\"\\n🎉 ALL BACKEND TEST CASES PASSED PERFECTLY!\\n\")\n","Description":"Comprehensive backend test script verifying all features","Overwrite":true,"TargetFile":"c:\\Users\\srira\\OneDrive\\Documents\\feedforward\\tests\\test_backend.py","toolAction":"Creating test_backend.py","toolSummary":"Create backend test suite"}}]}
